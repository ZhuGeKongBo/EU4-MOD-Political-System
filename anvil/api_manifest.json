{
  "interface_version": "0.9.2",
  "instance_fragments": "common/political_systems/instances/*.txt",
  "type_definitions": "common/political_systems/types/*.txt",
  "layout_definitions": "common/political_system_layouts/*.txt",
  "panel_background": {"path": "interface.background", "inherits": true, "clear": "use the layout's GUI sprite", "override_control": "iconType", "on_unavailable": "keep the GUI sprite and log a warning", "game_campaign_verified": false},
  "instance_history": "history/political_systems/*.txt",
  "native_clause_engine": {"loaded_and_checked_by": "EU4 1.37.5", "conditions": ["window access and entry", "member filters", "role eligibility", "leader eligibility", "nomination", "lifecycle", "defensive war", "resource monthly terms", "action and incident options"], "framework_context_selector": "INSTANCE", "offline_check": "structure and source locations", "game_campaign_verified": false},
  "action_clauses": {"conditions": ["potential", "trigger", "actor_trigger", "target_trigger", "can_stop"], "effects": ["effect", "on_effect", "off_effect", "removed_effect"], "continuous_modifiers": ["modifier", "emperor", "member", "province"], "native_ai_factor": "ai_will_do", "incident_model": "framework options; native scripts in each option"},
  "nomination": {"path": "leader.succession.nomination", "fields": ["min", "max", "base", "opinion_weight", "tooltip", "terms"], "term_fields": ["add", "elector_trigger", "candidate_trigger", "tooltip"], "score_limits": [-2000, 2000], "display": "elector to viewer", "layout_fields": ["nomination_score", "nomination_tooltip_control"]},
  "member_sources": ["explicit", "leader_subjects", "capital_territory", "query", "mixed"],
  "history": {"founding_fields": ["founded", "date"], "default_founding": "earliest date block", "dated_fields": ["leader", "members", "add_members", "remove_members", "territory", "add_provinces", "remove_provinces", "resources", "roles"], "province_markers": "territory.source=province_history and territory.history_key", "country_markers": "special_members.<role>.history_key"},
  "instance_registry": "common/political_systems/instances.txt",
  "resource": "authority",
  "legacy_alias_file": "common/political_systems/script_aliases.txt",
  "country_parameters": ["country tag", "ROOT", "THIS", "FROM", "PREV"],
  "province_parameter": ["province ID", "ROOT", "THIS", "FROM", "PREV"],
  "native_country_scopes": ["TAG", "FROM", "PREV", "any_country", "all_country", "every_country", "random_country"],
  "native_province_scopes": ["province ID", "capital_scope", "any_province", "every_province", "any_owned_province", "every_owned_province"],
  "native_modifiers": {"declarations": "common/political_modifiers/*.txt", "fields": ["scope", "localisation"], "scopes": ["country", "province"], "format": "percentage", "registration": "native registry (D11 A)", "binding": "resources.<id>.monthly_growth.growth_modifier", "binding_fields": ["key", "source"], "sources": ["leader", "account_country", "leader_capital", "account_capital"], "game_campaign_verified": false},
  "monthly_resource_terms": {"one_of": ["add", "modifier"], "instance_conditions": ["political_calculated_value", "political_has_reform"], "country_conditions": "EU4 trigger block and registered political triggers", "country_scope": "account owner or political_leader"},
  "political_localisation": {"bindings": "common/political_systems/localisation/*.txt", "template_fields": ["parameters", "template"], "binding_fields": ["source", "id"], "syntax": ["$NAME$", "$NAME|format$"], "consumers": ["political tooltip", "trigger/effect description", "notice body and log"], "resource_script_key": "resources.<id>.script_description", "threshold_notice_key": "resources.<id>.thresholds.<id>.message", "growth_term_label": "resources.<id>.monthly_growth.<term>.tooltip", "game_campaign_verified": false},
  "native_messages": {"path": "messages.<id>", "fields": ["title", "subtitle", "body", "log", "popup", "options"], "body_entries": 4, "option_labels": ["close", "secondary"], "effect": "political_send_message", "default_target": "THIS", "audience": "local player in the supported single-player campaign", "game_campaign_verified": false},
  "equivalent_commands": {"political_has_instance": "ps_has_instance", "political_is_leader": "ps_is_leader", "political_set_leader": "ps_set_leader", "political_clear_leader": "ps_clear_leader", "political_compare_resource": "ps_compare_resource", "political_set_resource": "ps_set_resource", "political_change_resource": "ps_change_resource", "political_is_candidate": "ps_is_candidate", "political_is_elector": "ps_is_elector", "political_vote_weight": "ps_vote_weight", "political_vote_total": "ps_vote_total", "political_election_round": "ps_election_round", "political_cast_vote": "ps_cast_vote", "political_resolve_election": "ps_resolve_election"},
  "operations": [
    {"name": "ps_has_instance", "kind": "trigger", "parameters": {"instance": {"required": true}, "value": {"required": true}}, "tooltip": "Campaign instance is active"},
    {"name": "ps_is_leader", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "type": {"required": false}}, "tooltip": "Check whether the country holds the leadership"},
    {"name": "ps_compare_resource", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "resource": {"required": true}, "amount": {"required": true}, "comparison": {"required": false}, "type": {"required": false}}, "tooltip": "Compare an instance or country decimal resource"},
    {"name": "ps_is_reform_passed", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "value": {"required": true}, "reform": {"required": true}, "type": {"required": false}}, "tooltip": "Check whether the reform passed"},
    {"name": "ps_set_leader", "kind": "effect", "one_of": ["instance", "type"], "country_target": {"one_of": ["country", "target"], "required": false}, "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "target": {"required": false, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Set the instance leader"},
    {"name": "ps_clear_leader", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "value": {"required": false}, "type": {"required": false}}, "tooltip": "Vacate the office"},
    {"name": "ps_set_resource", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "resource": {"required": true}, "amount": {"required": true}, "type": {"required": false}}, "tooltip": "Set an instance or country decimal resource"},
    {"name": "ps_change_resource", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "resource": {"required": true}, "amount": {"required": true}, "type": {"required": false}}, "tooltip": "Change an instance or country decimal resource"},
    {"name": "ps_execute_action", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "reform": {"required": true}, "type": {"required": false}}, "tooltip": "Pass the reform using the normal cost and eligibility rules"},
    {"name": "ps_is_candidate", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": true}, "type": {"required": false}}, "tooltip": "Check eligibility to stand for election"},
    {"name": "ps_is_elector", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": true}, "type": {"required": false}}, "tooltip": "Check eligibility to vote"},
    {"name": "ps_vote_weight", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "amount": {"required": true}, "comparison": {"required": false}, "type": {"required": false}}, "tooltip": "Compare a country's voting weight"},
    {"name": "ps_vote_total", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "amount": {"required": true}, "comparison": {"required": false}, "type": {"required": false}}, "tooltip": "Compare votes supporting a country"},
    {"name": "ps_election_round", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "round": {"required": true}, "type": {"required": false}}, "tooltip": "Check the active electoral term"},
    {"name": "ps_set_elector", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "amount": {"required": false}, "value": {"required": true}, "type": {"required": false}}, "tooltip": "Grant or revoke the scoped country's legacy electoral role"},
    {"name": "ps_cast_vote", "kind": "effect", "one_of": ["instance", "type"], "country_target": {"one_of": ["country", "target"], "required": true}, "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "round": {"required": true}, "target": {"required": false, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Vote for a candidate this term"},
    {"name": "ps_resolve_election", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "round": {"required": true}, "type": {"required": false}}, "tooltip": "Settle the named term and seat its winner"},
    {"name": "political_is_member", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "type": {"required": false}}, "tooltip": "Test membership of the current or specified country in one instance"},
    {"name": "political_set_member", "kind": "effect", "one_of": ["instance", "type"], "country_target": {"one_of": ["country", "target"], "required": false}, "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": true}, "target": {"required": false, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Add or remove an explicit or mixed member"},
    {"name": "political_has_role", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "role": {"required": true}, "type": {"required": false}}, "tooltip": "Test an appointment in one instance"},
    {"name": "political_set_role", "kind": "effect", "one_of": ["instance", "type"], "country_target": {"one_of": ["country", "target"], "required": true}, "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": true}, "role": {"required": true}, "target": {"required": false, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Appoint or revoke a role as the instance leader"},
    {"name": "political_has_province", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "value": {"required": false}, "province": {"required": true}, "type": {"required": false}}, "tooltip": "Test whether a province belongs to the instance territory"},
    {"name": "political_has_capital", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "type": {"required": false}}, "tooltip": "Test whether a country's current capital is in the instance territory"},
    {"name": "political_calculated_value", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": true}, "comparison": {"required": false}, "id": {"required": true}, "type": {"required": false}}, "tooltip": "Compare a read-only calculation"},
    {"name": "political_execute_action", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "action": {"required": true}, "actor": {"required": false, "accepts_leader": true}, "target": {"required": false, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Submit a configured political action"},
    {"name": "political_has_reform", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "value": {"required": false}, "id": {"required": true}, "type": {"required": false}}, "tooltip": "Test whether an instance has enacted the named reform"},
    {"name": "political_action_active", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "action": {"required": true}, "type": {"required": false}}, "tooltip": "Test whether a country receives this instance's reform or decree"},
    {"name": "political_start_contest", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "role": {"required": false}, "type": {"required": false}}, "tooltip": "Open competition for the specified office or leader"},
    {"name": "political_invest_contest", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "role": {"required": false}, "type": {"required": false}}, "tooltip": "Pay the configured investment as the current country"},
    {"name": "political_contest_winner", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "role": {"required": false}, "type": {"required": false}}, "tooltip": "Test the last completed result for an office or leader competition"},
    {"name": "political_has_permission", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "permission": {"required": true}, "type": {"required": false}}, "tooltip": "Test whether a current leader or office gives this permission"},
    {"name": "political_resolve_leader", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "type": {"required": false}}, "tooltip": "Run an explicitly configured highest-value leader selection"},
    {"name": "political_respond_request", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "value": {"required": true}, "round": {"required": true}, "action": {"required": true}, "type": {"required": false}}, "tooltip": "Accept or decline a specific invitation as its recipient"},
    {"name": "political_withdraw_request", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "round": {"required": true}, "action": {"required": true}, "target": {"required": true, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Withdraw a specific invitation as its issuer"},
    {"name": "political_resolve_incident", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "round": {"required": true}, "action": {"required": true}, "option": {"required": true}, "type": {"required": false}}, "tooltip": "Resolve a named incident with one configured option"},
    {"name": "political_process_status", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "round": {"required": false}, "action": {"required": true}, "target": {"required": false, "accepts_leader": true}, "option": {"required": false}, "status": {"required": true}, "type": {"required": false}}, "tooltip": "Match the state of an invitation or incident in one instance"},
    {"name": "political_create_instance", "kind": "effect", "parameters": {"instance": {"required": true}, "country": {"required": false, "accepts_leader": false}, "type": {"required": true}, "name": {"required": false}}, "tooltip": "Create a political instance as the scoped country"},
    {"name": "political_suspend_instance", "kind": "effect", "parameters": {"instance": {"required": true}}, "tooltip": "Suspend an active political instance as its leader"},
    {"name": "political_resume_instance", "kind": "effect", "parameters": {"instance": {"required": true}}, "tooltip": "Resume a suspended political instance as its leader"},
    {"name": "political_dissolve_instance", "kind": "effect", "parameters": {"instance": {"required": true}}, "tooltip": "Dissolve a political instance as its leader"},
    {"name": "political_instance_state", "kind": "trigger", "parameters": {"instance": {"required": true}, "status": {"required": true}}, "tooltip": "Match an active, suspended or dissolved instance"},
    {"name": "political_direct_war_allowed", "kind": "trigger", "parameters": {"actor": {"required": false, "accepts_leader": false}, "target": {"required": false, "accepts_leader": false}}, "tooltip": "Check political restrictions on direct declaration. Defaults to ROOT attacking the scoped country"},
    {"name": "political_set_province", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "value": {"required": true}, "province": {"required": true}, "type": {"required": false}}, "tooltip": "Add or remove a province in the instance's own territory"},
    {"name": "political_reform_level", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "amount": {"required": true}, "comparison": {"required": false}, "type": {"required": false}}, "tooltip": "Compare the number of reforms passed in this instance"},
    {"name": "political_set_reform", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "value": {"required": true}, "id": {"required": true}, "target": {"required": false, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Set a reform's enacted state without submitting the action"},
    {"name": "political_member_count", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "amount": {"required": true}, "comparison": {"required": false}, "type": {"required": false}}, "tooltip": "Compare the number of current members in this instance"},
    {"name": "political_role_count", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "amount": {"required": true}, "comparison": {"required": false}, "role": {"required": true}, "type": {"required": false}}, "tooltip": "Compare the number of current holders of a named office"},
    {"name": "political_province_count", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "amount": {"required": true}, "comparison": {"required": false}, "type": {"required": false}}, "tooltip": "Compare the number of provinces in this instance's territory"},
    {"name": "political_supports_candidate", "kind": "trigger", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "country": {"required": false, "accepts_leader": true}, "value": {"required": false}, "target": {"required": true, "accepts_leader": true}, "type": {"required": false}}, "tooltip": "Check which candidate the country's current vote supports"},
    {"name": "political_send_message", "kind": "effect", "one_of": ["instance", "type"], "parameters": {"instance": {"required": false}, "actor": {"required": false, "accepts_leader": true}, "target": {"required": false, "accepts_leader": true}, "type": {"required": false}, "message": {"required": true}}, "tooltip": "Send a configured native message to the scoped or specified country"}
  ]
}
